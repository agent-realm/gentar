#!/usr/bin/env bash
# Sign this host's sbx in to Docker so that local bench mode can read the
# login (GENTAR_BENCH_HOST=local).
#
# In local bench mode, sbx runs inside the coordinator container. There is no
# session bus in that container, so sbx reads its Docker login from files
# only (~/.config/com.docker.sandboxes/com.docker.sandboxes-auth/). A login
# that `sbx login` put in a desktop keyring (gnome-keyring, on a host with a
# session bus) is invisible there, and every bench fails at PREPARE IMAGE:
# "no default account profile set: secret not found".
#
# This script runs `sbx login` in a container with the same mounts as the
# coordinator and no session bus, so the login is written where the
# coordinator reads it. A keyring login the host already has stays as it is.
#
# Run it once, as the runner's user, on the bench host:
#   bin/sbx-file-login                                    # device flow
#   printf %s "$PAT" | bin/sbx-file-login --username <user> --password-stdin
#
# Arguments are passed to `sbx login`, and only these: --username <name>,
# --password-stdin, -h/--help. Anything else is refused WITHOUT echoing it:
# a token on the command line (ps, /proc, `docker inspect` would show it) can
# hide in any form (-p<token>, a bare word), and -D debug output may print
# auth. --password-stdin needs a pipe: typed at a terminal, the token echoes.
set -euo pipefail

usage='usage: sbx-file-login [--username <name> --password-stdin]   (token on stdin, from a pipe)'
expect_name=0
for a in "$@"; do
  if [ "$expect_name" = 1 ]; then expect_name=0; continue; fi
  case "$a" in
    --username) expect_name=1 ;;
    --username=?*) ;;
    -h|--help) ;;
    --password-stdin)
      if [ -t 0 ]; then
        echo "sbx-file-login: --password-stdin reads a pipe, not a terminal (a typed token would echo)" >&2
        echo "$usage" >&2
        exit 2
      fi ;;
    *)
      echo "sbx-file-login: refused an argument (not shown: it may be a token); only --username, --password-stdin and --help are passed to sbx login" >&2
      echo "$usage" >&2
      exit 2 ;;
  esac
done
if [ "$expect_name" = 1 ]; then echo "sbx-file-login: --username needs a name" >&2; exit 2; fi

SBX=$(command -v sbx 2>/dev/null || true)
[ -n "$SBX" ] || { echo "sbx-file-login: no sbx on PATH" >&2; exit 2; }
SBX=$(readlink -f "$SBX" 2>/dev/null || echo "$SBX")
# A missing bind source would be created by Docker as root; create it here,
# as this user, and refuse one that belongs to someone else.
for d in "$HOME/.local/state/sandboxes" "$HOME/.config/sandboxes" "$HOME/.config/com.docker.sandboxes"; do
  [ -e "$d" ] || mkdir -p -m 700 "$d" 2>/dev/null || true
  if [ ! -d "$d" ] || [ ! -O "$d" ]; then
    echo "sbx-file-login: $d is not a directory owned by $(id -un)" >&2
    exit 2
  fi
  chmod 700 "$d"
done

tty=()
[ -t 0 ] && tty=(-t)
rc=0
docker run --rm -i ${tty[@]+"${tty[@]}"} \
  --user "$(id -u):$(id -g)" -e HOME="$HOME" \
  -v "$SBX:/usr/bin/sbx:ro" \
  -v "$HOME/.local/state/sandboxes:$HOME/.local/state/sandboxes" \
  -v "$HOME/.config/sandboxes:$HOME/.config/sandboxes" \
  -v "$HOME/.config/com.docker.sandboxes:$HOME/.config/com.docker.sandboxes" \
  "${GENTAR_SBX_LOGIN_IMAGE:-alpine:3}" sbx login "$@" || rc=$?
# The file store is "protected by file permissions": its files are written
# 644 inside 700 folders. Owner-only all the way down, whatever the umask.
chmod -R go-rwx "$HOME/.config/com.docker.sandboxes"
exit "$rc"
