# gentar arena environment — copy to .env and point it at YOUR bench-host.
#
#   cp .env.example .env
#
# Every value maps to a GENTAR_* env var (coordinator/gentar/config.py).
# docker-compose.yml reads this file (env_file, required: false) into the
# coordinator. .env is gitignored — never commit it.
#
# Values here are PLACEHOLDERS. gentar ships no bench-host of its own, so
# the vars below that identify YOUR install have no built-in default: if
# the tier a run selects is unconfigured, the coordinator refuses the run
# (exit 2) before creating any bench, naming the var it needs.

# -- bench tier ----------------------------------------------------------

# Which kind of bench a run gets when the scenario does not say:
# "sbx" (default) · "tart" (macOS VMs) · "osb" · "daytona".
# A scenario's `bench = "..."` overrides this per-run, and only the
# selected tier's vars are required.
GENTAR_BENCH_KIND=sbx

# -- sbx tier (default): Linux bench-host --------------------------------

# Any Linux machine with `sbx` installed and logged in once (sbx login,
# device flow; the token persists). REQUIRED for the sbx tier — no
# default. The coordinator reaches it over ssh.
GENTAR_BENCH_HOST=bench.example.internal
GENTAR_BENCH_USER=bench

# SSH key the coordinator uses to reach the bench-host: the HOST-side
# file. docker-compose.yml mounts it into the coordinator as a compose
# secret, and this is the only variable that path comes from — the
# default is ~/.ssh/id_ed25519. (GENTAR_BENCH_KEY is the in-container
# mount path, set by the compose file itself; a value here would be
# overridden and is not the knob.) bin/arena refuses before starting
# anything when the file named here is missing.
GENTAR_BENCH_KEY_FILE=~/.ssh/id_ed25519

# Optional SSH jump host between the arena and the bench-host.
# Empty/unset = connect directly.
#GENTAR_BENCH_JUMP=user@gateway.example.internal

# known_hosts file the coordinator keeps bench-host keys in
# (StrictHostKeyChecking=accept-new).
#GENTAR_BENCH_KNOWN_HOSTS=/tmp/gentar-known-hosts

# The sbx binary on the bench-host, if it is not on PATH as `sbx`.
#GENTAR_SBX_BIN=sbx

# Bench-host dir that becomes each sandbox's workspace bind-mount.
#GENTAR_BENCH_WORKSPACE_ROOT=/tmp/gentar-workspaces

# -- tart tier (macOS): Apple-Silicon Mac host ---------------------------

# The Mac running the tart CLI (control plane) and the guest user benches
# ssh in as. Guest ssh jumps through the tart host — the VM's vmnet
# subnet is only routed on that Mac. The template VM must carry: sshd on,
# the coordinator pubkey authorized for the guest user, agent CLIs
# pre-installed. Host and user are REQUIRED when a run selects this tier.
#GENTAR_TART_HOST=mac.example.internal
#GENTAR_TART_USER=tart
#GENTAR_TART_VM_USER=admin
# Absolute path: non-interactive ssh shells don't source PATH wrappers.
#GENTAR_TART_BIN=/opt/homebrew/bin/tart

# -- osb tier (OpenSandbox containers) -----------------------------------

# The opensandbox-server driving the benches: either the compose profile
# (docker compose --profile osb …, service address below) or any external
# server. Templates are image refs on that server's docker daemon.
# GENTAR_OSB_SERVER_PROXY=1 routes sandbox traffic through the server
# itself (Linux hairpin setups); the compose profile instead rewrites
# endpoints via osb/server.toml host_ip, which the coordinator resolves.
#GENTAR_OSB_SERVER=http://osb-server:8080
#GENTAR_OSB_API_KEY=
#GENTAR_OSB_TEMPLATE=python:3.12-slim
#GENTAR_OSB_SERVER_PROXY=1
# Host port the compose osb profile publishes the server on.
#GENTAR_OSB_HOST_PORT=8180

# -- daytona tier (Daytona cloud sandboxes) ------------------------------

# Benches minted through the Daytona SDK, exec/pty over ssh with a
# per-sandbox expiring token as the username. The API key is REQUIRED
# when a run selects this tier; it is coordinator-scoped — prefer
# passing it at run time (-e GENTAR_DAYTONA_API_KEY=…) over writing it
# here, and never declare it as a scenario credential. Templates are
# public image refs with a tag or digest (no `latest`).
#GENTAR_DAYTONA_API_KEY=
#GENTAR_DAYTONA_IMAGE=python:3.12-slim
#GENTAR_DAYTONA_SSH_HOST=ssh.app.daytona.io

# -- arena services ------------------------------------------------------

# Arena-internal ClickHouse credentials (compose network + localhost
# only) and the database the spans land in.
#GENTAR_CH_USER=gentar
#GENTAR_CH_PASSWORD=gentar
#GENTAR_CH_DB=gentar

# Host ports the arena publishes. Two arenas on one Docker host (gentar's
# own gate and a subject repo's own-arena) collide on the defaults —
# override these instead of editing docker-compose.yml.
#GENTAR_CLICKHOUSE_HOST_PORT=8123
#GENTAR_OTLP_HOST_PORT=4318

# What the coordinator itself uses to reach ClickHouse and otelcol.
# Compose derives the first three from the GENTAR_CH_* values above and
# points the URLs at the service names; set these only for an arena
# running outside this compose file.
#GENTAR_CLICKHOUSE_URL=http://clickhouse:8123
#GENTAR_CLICKHOUSE_USER=gentar
#GENTAR_CLICKHOUSE_PASSWORD=gentar
#GENTAR_CLICKHOUSE_DB=gentar
#GENTAR_OTLP_ENDPOINT=http://otelcol:4318

# -- runs ----------------------------------------------------------------

# Subject checkouts, mounted read-only into the coordinator at
# /subjects. A scenario's `subject` names a dir under this.
#GENTAR_SUBJECTS_DIR=./subjects
#GENTAR_SUBJECTS_ROOT=/subjects

# Extra directory of TOML scenarios, appended to the baked-in set.
#GENTAR_SCENARIOS_DIR=

# Sandbox name prefix; the run id is appended by the coordinator.
#GENTAR_NAME_PREFIX=gentar

# sbx bench-hosts: a host with stored sbx secrets (`sbx secret ls`) is
# refused — sbx's credential proxy would hand them to every sandbox,
# whatever credentials a run forwards. "allow" if this arena uses sbx
# secrets as its credential mechanism on purpose.
#GENTAR_SBX_SECRETS=allow

# Flake quarantine: comma-separated scenario names. A quarantined
# scenario is SKIPPED (exit 0), never failed.
#GENTAR_QUARANTINE=

# Budget cap in spend units (0 = off). A scenario declaring [budget]
# tokens is refused (exit 2) when past spend plus its declaration would
# exceed the cap.
#GENTAR_BUDGET_CAP=0

# Engine provenance: the coordinator image has no .git, so CI injects
# the sha at deploy time; local runs read "dev".
#GENTAR_ENGINE_SHA=dev
#GENTAR_ENGINE_DIRTY=

# Run reports: every run writes a markdown report here (./out is bound
# into the container at /out). Empty disables reporting.
#GENTAR_REPORT_DIR=/out

# Keep the bench after a run, for post-mortem (debugging; you own the rm).
#GENTAR_KEEP_BENCH=1
# Keep the arena stack up after bin/arena run (you own `bin/arena down`).
#GENTAR_KEEP_ARENA=1
