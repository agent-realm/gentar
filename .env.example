# gentar arena environment — copy to .env and point at your bench-host.
# Every value maps to a GENTAR_* env var (coordinator/gentar/config.py);
# unset means the documented default (VM 142, gentar-bench-host on arf).

# Bench-host: any Linux machine with `sbx` installed and logged in once
# (sbx login, device flow; the token persists).
GENTAR_BENCH_HOST=10.10.10.52
GENTAR_BENCH_USER=polat

# SSH key the coordinator uses to reach the bench-host. Inside the
# coordinator container this is the path named by GENTAR_BENCH_KEY_FILE;
# on the host it is your key file.
GENTAR_BENCH_KEY=~/.ssh/id_ed25519

# Optional SSH jump host between the arena and the bench-host.
#GENTAR_BENCH_JUMP=pilot@arf

# Bench tier: "sbx" (default) or "tart" (macOS VMs). A scenario's
# `bench = "tart"` overrides this per-run.
GENTAR_BENCH_KIND=sbx

# tart tier (macOS): the Mac running the tart CLI (control plane) and
# the guest user benches ssh in as. Guest ssh jumps through the tart
# host — the VM's vmnet subnet is only routed on that Mac. The template
# VM (e.g. gentar-bench-macos-v1) must carry: sshd on, the coordinator
# pubkey authorized for the guest user, agent CLIs pre-installed.
#GENTAR_TART_HOST=macminim
#GENTAR_TART_USER=polat
#GENTAR_TART_VM_USER=admin

# osb tier (OpenSandbox containers): the opensandbox-server driving the
# benches. Either the compose profile (docker compose --profile osb …,
# service address below) or any external server. Templates are image
# refs on that server's docker daemon. GENTAR_OSB_SERVER_PROXY=1 routes
# sandbox traffic through the server itself (Linux hairpin setups);
# the compose profile instead rewrites endpoints via osb/server.toml
# host_ip, which the coordinator container resolves.
#GENTAR_OSB_SERVER=http://osb-server:8080
#GENTAR_OSB_API_KEY=
#GENTAR_OSB_TEMPLATE=python:3.12-slim
#GENTAR_OSB_SERVER_PROXY=1
