# gentar arena — copy to .env and adjust. All optional; defaults match
# the phase-1 setup (spike VM 9100 on arf, direct SSH).

# Bench-host (any host with `sbx` installed and logged in once).
GENTAR_BENCH_HOST=10.10.10.200
GENTAR_BENCH_USER=polat
# Optional SSH jump, e.g. "pilot@arf". Empty = direct.
GENTAR_BENCH_JUMP=

# Host-side path of the SSH key the coordinator uses to reach the
# bench-host (mounted via compose secrets). Expand in your shell:
#   GENTAR_BENCH_KEY_FILE=~/...
GENTAR_BENCH_KEY_FILE=/Users/polat/.ssh/id_ed25519

# ClickHouse (inside the compose network; override only for a remote sink).
# GENTAR_CLICKHOUSE_URL=http://clickhouse:8123
# GENTAR_CLICKHOUSE_DB=gentar
