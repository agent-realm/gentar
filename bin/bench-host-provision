#!/usr/bin/env bash
# bench-host-provision: turn a fresh Ubuntu 24.04 machine into a gentar
# bench host, with an isolated runner/bench account from the start.
#
#   ssh <admin>@<host> 'bash -s' < bin/bench-host-provision
#   ssh <admin>@<host> 'GENTAR_BENCH_ACCOUNT=arena SBX_VERSION=0.45.1-1~ubuntu.24.04~noble bash -s' < bin/bench-host-provision
#
# Run as an admin with sudo, never as the bench account. Idempotent: run it
# again after a change. The layout it builds:
#   - the admin account: administration only, no CI anything;
#   - the bench account (GENTAR_BENCH_ACCOUNT, default `arena`, uid
#     GENTAR_BENCH_UID, default 1001): the ONLY account the arena and the CI
#     runner use. Password locked, no sudo, groups <account> + kvm only (never
#     docker, adm, lxd or sudo), home 750;
#   - rootless Docker for that account; the rootful daemon is installed (a
#     package dependency) but disabled, so no socket gives root;
#   - sbx (docker-sbx) pinned (SBX_VERSION) and held, its daemon as a user
#     unit, and a headless gnome-keyring started UNLOCKED from a password file
#     (docs/guides/deploy-an-arena.md: the keyring pattern; for disposable test
#     benches only);
#   - the bench workspace root (GENTAR_BENCH_WORKSPACE_ROOT, default
#     /tmp/gentar-workspaces) owned by the bench account, 0700;
#   - Docker's networks in GENTAR_DOCKER_POOL (default 10.201.0.0/16): keep it
#     off every range the host's own networks use.
#
# Contains no secret values. The one secret it creates is the keyring
# password: random bytes written straight to ~<account>/.keyring-pass (600),
# never printed. NOT done here, each its own step: `sbx login` as the bench
# account (bin/sbx-file-login), the bench template, the CI runner's
# registration, and the bench SSH key in ~<account>/.ssh/authorized_keys.
#
# Ubuntu 24.04 (noble) only: the package names, the Docker apt suite and the
# AppArmor rule for rootlesskit are noble's. Anything else is refused before
# a single change is made.
#
# Exit: 0 provisioned, proofs printed · 2 refused (wrong OS, run as the bench
# account, a bad parameter).

set -euo pipefail

ACCOUNT=${GENTAR_BENCH_ACCOUNT:-arena}
ACCOUNT_UID=${GENTAR_BENCH_UID:-1001}
WSROOT=${GENTAR_BENCH_WORKSPACE_ROOT:-/tmp/gentar-workspaces}
POOL=${GENTAR_DOCKER_POOL:-10.201.0.0/16}
SBX_VERSION=${SBX_VERSION:-0.39.0-1~ubuntu.24.04~noble}
OS_RELEASE=${GENTAR_OS_RELEASE:-/etc/os-release}   # tests point this elsewhere

refuse() { echo "bench-host-provision: $*" >&2; exit 2; }
case "$ACCOUNT" in ''|*[!a-z0-9_-]*|[!a-z]*) refuse "bad GENTAR_BENCH_ACCOUNT: $ACCOUNT" ;; esac
case "$ACCOUNT_UID" in ''|*[!0-9]*) refuse "bad GENTAR_BENCH_UID: $ACCOUNT_UID" ;; esac
case "$WSROOT" in /*) ;; *) refuse "GENTAR_BENCH_WORKSPACE_ROOT must be an absolute path" ;; esac
case "$WSROOT" in *[!A-Za-z0-9._/-]*) refuse "bad GENTAR_BENCH_WORKSPACE_ROOT: $WSROOT" ;; esac
case "$POOL" in *[!0-9./]*|'') refuse "bad GENTAR_DOCKER_POOL: $POOL" ;; esac
case "$SBX_VERSION" in *[!A-Za-z0-9.~:+-]*|'') refuse "bad SBX_VERSION: $SBX_VERSION" ;; esac
# Read, not sourced: os-release is data here.
os="$(sed -n 's/^ID=//p' "$OS_RELEASE" 2>/dev/null | tr -d '"' | head -1) $(sed -n 's/^VERSION_ID=//p' "$OS_RELEASE" 2>/dev/null | tr -d '"' | head -1)"
[ "$os" = "ubuntu 24.04" ] || refuse "Ubuntu 24.04 only (this is '${os:-unknown}')"
ADMIN=$(id -un)
[ "$ADMIN" != "$ACCOUNT" ] || refuse "run it as an admin with sudo, not as $ACCOUNT"
[ "$(id -u)" != 0 ] || refuse "run it as an admin with sudo, not as root (the proofs compare against the admin's home)"
RUN="/run/user/$ACCOUNT_UID"

echo "== apt base"
sudo DEBIAN_FRONTEND=noninteractive apt-get update -q >/dev/null
# libicu74 libkrb5-3 zlib1g: the GitHub Actions runner's own dependencies.
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
  ca-certificates curl gnupg jq git rsync unzip make python3 python3-venv \
  uidmap slirp4netns dbus-user-session gnome-keyring libsecret-tools \
  libicu74 libkrb5-3 zlib1g >/dev/null && echo ok

echo "== docker apt repo"
sudo install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo tee /etc/apt/keyrings/docker.asc >/dev/null
sudo chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" \
  | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
sudo DEBIAN_FRONTEND=noninteractive apt-get update -q >/dev/null
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
  docker-ce docker-ce-cli containerd.io docker-ce-rootless-extras \
  docker-buildx-plugin docker-compose-plugin "docker-sbx=${SBX_VERSION}" >/dev/null
sudo apt-mark hold docker-sbx >/dev/null
sbx version

echo "== rootful dockerd off (the bench account uses rootless Docker)"
sudo systemctl disable --now docker.service docker.socket >/dev/null 2>&1 || true
systemctl is-active docker.service || true

echo "== apparmor: allow rootlesskit user namespaces (Ubuntu 24.04 restricts them)"
sudo tee /etc/apparmor.d/usr.bin.rootlesskit >/dev/null <<'AA'
# rootless Docker for the gentar bench account (bin/bench-host-provision)
abi <abi/4.0>,
include <tunables/global>

/usr/bin/rootlesskit flags=(unconfined) {
  userns,
  include if exists <local/usr.bin.rootlesskit>
}
AA
sudo apparmor_parser -r /etc/apparmor.d/usr.bin.rootlesskit

echo "== bench account $ACCOUNT"
id "$ACCOUNT" >/dev/null 2>&1 || sudo useradd -m -u "$ACCOUNT_UID" -U -s /bin/bash -G kvm \
  -c "gentar CI runner + bench account (bin/bench-host-provision)" "$ACCOUNT"
[ "$(id -u "$ACCOUNT")" = "$ACCOUNT_UID" ] || refuse "$ACCOUNT exists with uid $(id -u "$ACCOUNT"), not $ACCOUNT_UID"
sudo passwd -l "$ACCOUNT" >/dev/null
sudo chmod 750 "/home/$ACCOUNT"
grep -q "^$ACCOUNT:" /etc/subuid || echo "$ACCOUNT:165536:65536" | sudo tee -a /etc/subuid >/dev/null
grep -q "^$ACCOUNT:" /etc/subgid || echo "$ACCOUNT:165536:65536" | sudo tee -a /etc/subgid >/dev/null
sudo loginctl enable-linger "$ACCOUNT"
for _ in $(seq 1 20); do sudo test -S "$RUN/bus" && break; sleep 1; done
sudo ls -ld "$RUN" "$RUN/bus"

echo "== bench workspace root"
echo "d $WSROOT 0700 $ACCOUNT $ACCOUNT -" | sudo tee /etc/tmpfiles.d/gentar-workspaces.conf >/dev/null
sudo systemd-tmpfiles --create /etc/tmpfiles.d/gentar-workspaces.conf
stat -c '%n %U %a' "$WSROOT"

echo "== $ACCOUNT's user units"
sudo -u "$ACCOUNT" -H env ACCOUNT="$ACCOUNT" RUN="$RUN" POOL="$POOL" bash -euo pipefail <<'IN'
umask 077
cd ~
[ -s ~/.keyring-pass ] || head -c 48 /dev/urandom | base64 -w0 > ~/.keyring-pass
chmod 600 ~/.keyring-pass
mkdir -p ~/.config/systemd/user/gnome-keyring.service.d ~/.local/share/dbus-1/services \
  ~/.config/environment.d ~/.config/docker

cat > ~/.config/systemd/user/gnome-keyring.service <<'U'
[Unit]
Description=gnome-keyring secrets, started unlocked (gentar bench host)
After=dbus.socket
[Service]
ExecStart=/bin/sh -c "exec /usr/bin/gnome-keyring-daemon --foreground --components=secrets --unlock < $HOME/.keyring-pass"
Type=simple
Restart=on-failure
[Install]
WantedBy=default.target
U

cat > ~/.config/systemd/user/gnome-keyring.service.d/override.conf <<U
[Service]
ExecStartPre=-/usr/bin/pkill -u $ACCOUNT -x gnome-keyring-d
Restart=always
RestartSec=3
U

cat > ~/.config/systemd/user/sandboxd.service <<'U'
[Unit]
Description=sbx sandboxd daemon (gentar bench host)
After=network-online.target

[Service]
ExecStart=/usr/bin/sbx daemon start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
U

cat > ~/.local/share/dbus-1/services/org.freedesktop.secrets.service <<'U'
# D-Bus activation of the secrets service goes through the UNLOCKING unit,
# never the stock locked daemon (docs/guides/deploy-an-arena.md).
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/bin/false
SystemdService=gnome-keyring.service
U

# rootless dockerd: keep Docker's networks off the host's own ranges
printf '{ "default-address-pools": [ { "base": "%s", "size": 24 } ] }\n' "$POOL" > ~/.config/docker/daemon.json

echo "DOCKER_HOST=unix://$RUN/docker.sock" > ~/.config/environment.d/docker.conf
grep -q "DOCKER_HOST=unix://$RUN" ~/.bashrc || \
  sed -i "1i export DOCKER_HOST=unix://$RUN/docker.sock  # rootless docker" ~/.bashrc
chmod 755 ~/.config ~/.config/systemd ~/.config/systemd/user ~/.local ~/.local/share \
  ~/.local/share/dbus-1 ~/.local/share/dbus-1/services ~/.config/environment.d ~/.config/docker
chmod 644 ~/.config/systemd/user/*.service ~/.config/systemd/user/gnome-keyring.service.d/override.conf \
  ~/.local/share/dbus-1/services/*.service ~/.config/environment.d/docker.conf ~/.config/docker/daemon.json

export XDG_RUNTIME_DIR="$RUN" DBUS_SESSION_BUS_ADDRESS="unix:path=$RUN/bus"
systemctl --user daemon-reload
systemctl --user enable --now gnome-keyring.service sandboxd.service

echo "== rootless docker"
dockerd-rootless-setuptool.sh install 2>&1 | tail -3
systemctl --user enable docker.service >/dev/null 2>&1 || true
systemctl --user is-active gnome-keyring.service sandboxd.service docker.service
IN

echo "== proofs (each must say REFUSED; then rootless, a route in the pool, the sbx version)"
p() { local err
  if err=$(sudo -u "$ACCOUNT" -H "${@:2}" 2>&1 >/dev/null); then echo "FAIL (allowed): $1"
  else echo "REFUSED: $1 -- ${err%%$'\n'*}"; fi; }
p "ls /home/$ADMIN"                 ls "/home/$ADMIN"
p "read $ADMIN's authorized_keys"   head -c1 "/home/$ADMIN/.ssh/authorized_keys"
p "sudo -n"                         sudo -n true
p "rootful docker socket (info)"    docker -H unix:///var/run/docker.sock info
if id -nG "$ACCOUNT" | tr " " "\n" | grep -qxE "docker|sudo|adm|lxd"; then echo "FAIL (privileged group): $(id -nG "$ACCOUNT")"
else echo "REFUSED: no docker/sudo/adm/lxd group ($(id -nG "$ACCOUNT"))"; fi
A="sudo -u $ACCOUNT -H env XDG_RUNTIME_DIR=$RUN DOCKER_HOST=unix://$RUN/docker.sock"
$A docker info --format '{{.SecurityOptions}}' | grep -o 'name=rootless'
$A docker run --rm alpine:3 sh -c 'ip -4 route | head -1'
$A sbx version
id "$ACCOUNT"
echo "next, each its own step: sbx login as $ACCOUNT (bin/sbx-file-login), the bench template, the runner (as $ACCOUNT, with DOCKER_HOST=unix://$RUN/docker.sock and XDG_RUNTIME_DIR=$RUN in its .env), and the bench key in ~$ACCOUNT/.ssh/authorized_keys"
