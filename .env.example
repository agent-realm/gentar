# gentar arena environment — copy to .env and point at your bench-host.
# Every value maps to a GENTAR_* env var (coordinator/gentar/config.py);
# unset means the documented default (VM 142, gentar-bench-host on arf).

# Bench-host: any Linux machine with `sbx` installed and logged in once
# (sbx login, device flow; the token persists).
GENTAR_BENCH_HOST=10.10.10.52
GENTAR_BENCH_USER=polat

# SSH key the coordinator uses to reach the bench-host. Inside the
# coordinator container this is the path named by GENTAR_BENCH_KEY_FILE;
# on the host it is your key file.
GENTAR_BENCH_KEY=~/.ssh/id_ed25519

# Optional SSH jump host between the arena and the bench-host.
#GENTAR_BENCH_JUMP=pilot@arf

# Bench tier: "sbx" (default) or "tart" (macOS VMs). A scenario's
# `bench = "tart"` overrides this per-run.
GENTAR_BENCH_KIND=sbx

# tart tier (macOS): the Mac running the tart CLI (control plane) and
# the guest user benches ssh in as. Guest ssh jumps through the tart
# host — the VM's vmnet subnet is only routed on that Mac. The template
# VM (e.g. gentar-bench-macos-v1) must carry: sshd on, the coordinator
# pubkey authorized for the guest user, agent CLIs pre-installed.
#GENTAR_TART_HOST=macminim
#GENTAR_TART_USER=polat
#GENTAR_TART_VM_USER=admin

# Host port publishes. The suites reach ClickHouse and otelcol over the
# compose network; these are host-side bindings only (dashboard, debug,
# manual OTLP POSTs), both loopback-only. Defaults 18123 / 14318 — off
# the canonical 8123 / 4318 on purpose: those are the ports something
# else already owns (a native clickhouse-server, another OTLP receiver),
# and on some Docker hosts (OrbStack) losing that race fails SILENTLY —
# the published port answers the foreign server while runs stay green.
# Two arenas on one Docker host need distinct values for both.
GENTAR_CLICKHOUSE_HOST_PORT=18123
GENTAR_OTELCOL_HOST_PORT=14318

# Arena identity — the two knobs that let arenas coexist:
#
# COMPOSE_PROJECT_NAME is the arena's identity ON THE DOCKER HOST. Two
# checkouts that end up with the same project name (same dir basename,
# or a shared shell export) are ONE merged arena: the second silently
# attaches to the first's containers and both write spans into one
# ClickHouse volume, no error anywhere. Set it HERE — .env is sticky
# per checkout, while a shell export is per-invocation (a later compose
# call without it reverts to the file's ports and takes the running
# stack down with a bind error naming neither). Rule: one arena = one
# .env; everything in it, nothing on the shell.
#COMPOSE_PROJECT_NAME=gentar-alice
#
# GENTAR_NAME_PREFIX is the arena's identity ON A SHARED BENCH-HOST.
# It prefixes every run_id, so sandbox names, workspace dirs, span
# run_ids, and report filenames all carry it — an operator reading
# `sbx ls` can tell whose sandbox it is without out-of-band knowledge.
# Lowercase-with-dashes, 24 chars max.
#GENTAR_NAME_PREFIX=gentar-alice
