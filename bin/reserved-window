#!/usr/bin/env bash
# Is it inside a window other arenas have reserved on the shared bench host?
#
#   bin/reserved-window [HH:MM]      # default: now, UTC
#
# Windows come from GENTAR_RESERVED_UTC, a comma-separated list of
# HH:MM-HH:MM ranges in UTC (end exclusive), default the adopters' nightly
# slots: claude-playbooks at 02:17, cockpit at 04:17. GitHub starts scheduled
# runs late under load (gentar's 00:17 nightly started at 05:14Z on
# 2026-09-27, inside cockpit's slot), so a cron time alone keeps nothing out.
#
# Exit 0: inside a reserved window (prints which); 1: clear; 2: bad input.
set -euo pipefail
now=${1:-$(date -u +%H:%M)}
windows=${GENTAR_RESERVED_UTC-02:00-03:30,04:00-05:30}

mins() {                       # HH:MM -> minutes since midnight, or fail
  [[ $1 =~ ^([01][0-9]|2[0-3]):([0-5][0-9])$ ]] || return 1
  echo $((10#${BASH_REMATCH[1]} * 60 + 10#${BASH_REMATCH[2]}))
}

t=$(mins "$now") || { echo "bad time: $now (HH:MM, UTC)" >&2; exit 2; }
IFS=, read -r -a list <<<"$windows"
for w in ${list[@]+"${list[@]}"}; do
  [ -n "$w" ] || continue
  a=$(mins "${w%-*}") && b=$(mins "${w#*-}") && [ "${w%-*}-${w#*-}" = "$w" ] \
    || { echo "bad window: $w (HH:MM-HH:MM, UTC)" >&2; exit 2; }
  if { [ "$a" -le "$b" ] && [ "$t" -ge "$a" ] && [ "$t" -lt "$b" ]; } \
     || { [ "$a" -gt "$b" ] && { [ "$t" -ge "$a" ] || [ "$t" -lt "$b" ]; }; }; then
    echo "$now UTC is inside reserved window $w"
    exit 0
  fi
done
exit 1
